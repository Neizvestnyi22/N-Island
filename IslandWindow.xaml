<Window x:Class="NIsland.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NIsland.Controls"
        Title="N-Island"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        AllowDrop="True" Foreground="White" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <Grid x:Name="Root">
        <!-- «стекло»: размытый снимок того, что под чёлкой; форму задаёт регион окна -->
        <Image x:Name="GlassImg" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill"
               Visibility="Collapsed" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect>
                <BlurEffect Radius="22" RenderingBias="Performance"/>
            </Image.Effect>
        </Image>

        <!-- «плечики» классической чёлки -->
        <Path x:Name="EarL" Width="12" Height="12" Stretch="None"
              HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
              Data="M0,0 L12,0 L12,12 A12,12 0 0 0 0,0 Z">
            <Path.RenderTransform><TranslateTransform/></Path.RenderTransform>
        </Path>
        <Path x:Name="EarR" Width="12" Height="12" Stretch="None"
              HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
              Data="M12,0 L0,0 L0,12 A12,12 0 0 1 12,0 Z">
            <Path.RenderTransform><TranslateTransform/></Path.RenderTransform>
        </Path>

        <Border x:Name="Island" HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="190" Height="32" CornerRadius="0,0,16,16" Cursor="Arrow">
            <Grid x:Name="Stage">
                <!-- блик и ободок «жидкого стекла» -->
                <Border x:Name="Sheen" IsHitTestVisible="False" VerticalAlignment="Top"/>
                <Border x:Name="Rim" IsHitTestVisible="False" BorderThickness="1.2"/>

                <!-- ===== Свёрнуто ===== -->
                <Grid x:Name="CollapsedView" Height="32" VerticalAlignment="Top" Margin="11,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="20" Height="20" VerticalAlignment="Center">
                        <c:StatusRing x:Name="ColRing" Thickness="2.4"/>
                        <Border x:Name="ColArt" CornerRadius="5" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="ColArtBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="ColNote" Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource ArtBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Border x:Name="ColMic" CornerRadius="10" Background="#30D158" Visibility="Collapsed">
                            <TextBlock x:Name="ColMicGlyph" Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="Black"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Column="1" ClipToBounds="True">
                        <TextBlock x:Name="ColTime" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ColLyric" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="8,0" Visibility="Collapsed"/>
                    </Grid>
                    <!-- тонкая полоска прогресса трека внизу свёрнутой чёлки -->
                    <Border x:Name="ColProgress" Grid.ColumnSpan="3" Height="2" CornerRadius="1" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            Margin="2,0,0,3" Width="0" Background="{DynamicResource ArtBrush}" Opacity="0.85" IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" MinWidth="20">
                        <TextBlock x:Name="ColBadge" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource DimBrush}" Margin="0,0,6,0" Visibility="Collapsed"/>
                        <Grid>
                            <c:EqBars x:Name="Bars" Width="20" Height="13" BarBrush="{DynamicResource ArtBrush}" Visibility="Collapsed"/>
                            <TextBlock x:Name="ColRight" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ===== Всплывашка ===== -->
                <Grid x:Name="ActivityView" Height="46" VerticalAlignment="Top" Margin="12,0,12,0" Opacity="0" Visibility="Hidden">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ActIconBox" Width="30" Height="30" CornerRadius="8" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="ActGlyph" FontFamily="{StaticResource IconFont}" FontSize="17"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="ActImage" CornerRadius="7" Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="ActImageBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                        <TextBlock x:Name="ActTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ActSub" FontSize="11.5" Foreground="{StaticResource DimBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid x:Name="ActBar" Width="110" Height="6" Visibility="Collapsed">
                            <Border CornerRadius="3" Background="#33FFFFFF"/>
                            <Border x:Name="ActBarFill" CornerRadius="3" Background="White" HorizontalAlignment="Left" Width="40"/>
                        </Grid>
                        <Button x:Name="ActButton" Style="{StaticResource AccentPill}" Visibility="Collapsed" Padding="12,4"/>
                    </Grid>
                </Grid>

                <!-- ===== Раскрыто ===== -->
                <Grid x:Name="ExpandedView" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="22,6,22,0">
                        <TextBlock x:Name="PageTitle" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <c:StatusRing x:Name="HeadRing" Width="15" Height="15" Thickness="2" Margin="0,0,8,0"/>
                            <TextBlock x:Name="DateText" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TimeText" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="HeadExtra" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="HeadBattery" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="GearBtn" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"
                                    Content="&#xE713;" Margin="6,0,0,0" ToolTip="Настройки" Foreground="{StaticResource DimBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PrevPage" Width="24" Height="24" FontSize="10" Content="&#xE76B;"
                                Foreground="White" FontFamily="{StaticResource IconFont}" Cursor="Hand" Focusable="False"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="#26FFFFFF" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#48FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False" Margin="6,0">
                            <ContentControl.RenderTransform><TranslateTransform/></ContentControl.RenderTransform>
                        </ContentControl>
                        <Button x:Name="NextPage" Grid.Column="2" Width="24" Height="24" FontSize="10" Content="&#xE76C;"
                                Foreground="White" FontFamily="{StaticResource IconFont}" Cursor="Hand" Focusable="False"
                                VerticalAlignment="Center" HorizontalAlignment="Left" Template="{Binding Template, ElementName=PrevPage}"/>
                    </Grid>

                    <StackPanel x:Name="Dots" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"
                                Background="Transparent" Margin="0,2,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== Пузырёк сбоку: скрыть, закрепить, не беспокоить, режимы ===== -->
        <Border x:Name="Bubble" HorizontalAlignment="Center" VerticalAlignment="Top" Height="40" CornerRadius="20"
                Opacity="0" Visibility="Collapsed" Padding="4,0">
            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            <Grid>
                <Border x:Name="BubRim" CornerRadius="20" BorderThickness="1.2" Margin="-4,0" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BubHide" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="&#xED1A;" ToolTip="Скрыть чёлку (клик по полоске — вернуть)"/>
                    <Button x:Name="BubPin" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="&#xE718;" ToolTip="Закрепить открытой"/>
                    <Button x:Name="BubDnd" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="&#xE708;" ToolTip="Не беспокоить"/>
                    <Button x:Name="BubModes" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="&#xE790;" ToolTip="Режимы и стиль"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
